{
  "name": "isolation",
  "version": "5.0.0",
  "private": true,
  "description": "A music library that composes itself as a night sky.",
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-tar.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-syntax.cjs",
    "audit": "npm audit --audit-level=high",
    "ios": "cap add ios || true && cap sync ios && cap open ios",
    "sync": "cap sync ios",
    "test:browser": "node test/run.mjs",
    "fixtures": "python3 test/fixtures.py",
    "test:interface": "node test/interface.mjs",
    "test:interface:ci": "node scripts/test-interface-ci.mjs",
    "test:arrival": "node test/arrival.mjs",
    "test:sky-chrome": "node test/sky-chrome.mjs",
    "test:native-audio": "node test/native-audio-contract.mjs",
    "test:legacy-migration": "node test/legacy-migration-contract.mjs",
    "test:ios": "node scripts/test-ios.mjs --family=all",
    "test:ios:iphone": "node scripts/test-ios.mjs --family=iphone",
    "test:ios:ipad": "node scripts/test-ios.mjs --family=ipad"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "tar": "7.5.22",
    "brace-expansion": "2.1.4",
    "@xmldom/xmldom": "0.9.12"
  }
}
